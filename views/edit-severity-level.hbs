<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Severity Level - CIRT</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="logo">CIRT</h1>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/incidents">Incidents</a></li>
                <li><a href="/analysts">Analysts</a></li>
                <li><a href="/assets">Assets</a></li>
                <li><a href="/cves">CVEs</a></li>
                <li><a href="/severity-levels">Severity Levels</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h2>Edit Severity Level</h2>
        </div>

        <form method="POST" action="/severity-levels/{{severity.severityLevelID}}" class="form">
            <div class="form-group">
                <label for="severityName">Severity Name *</label>
                <input type="text" id="severityName" name="severityName" value="{{severity.severityName}}" required>
            </div>

            <div class="form-group">
                <label for="responseHours">Response Hours *</label>
                <input type="number" id="responseHours" name="responseHours" value="{{severity.responseHours}}" required min="0">
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Update Severity Level</button>
                <a href="/severity-levels" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <footer>
        <p>&copy; 2026 CIRT - CS340 Group 38</p>
    </footer>
</body>
</html>