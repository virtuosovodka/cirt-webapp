<div class="page-header">
    <h2>Statuses</h2>
    <a href="/statuses/add" class="btn btn-primary">+ Add New Status</a>
</div>

<div class="entity-description">
    <h3>What are Statuses?</h3>
    <p>
        Statuses represent the current state of an incident throughout its lifecycle. Each status reflects where an incident stands in the investigation and response process. Standard statuses include Open (newly reported), Investigating (actively being worked on), and Closed (resolved or concluded).
    </p>
    <div class="description-meta">
        <span><strong>Standard Statuses:</strong> Open, Investigating, Closed</span>
        <span><strong>Purpose:</strong> Track incident workflow and prioritize investigation efforts</span>
    </div>
</div>

<div class="crud-section">
    {{#if statuses}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Status Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each statuses}}
                    <tr>
                        <td>{{this.statusID}}</td>
                        <td><span class="status-badge status-{{this.statusName}}">{{this.statusName}}</span></td>
                        <td>
                            <a href="/statuses/{{this.statusID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <form method="POST" action="/statuses/{{this.statusID}}/delete" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-small" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No statuses found. <a href="/statuses/add">Add one now</a></p>
    {{/if}}
</div>