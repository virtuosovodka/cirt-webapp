<div class="page-header">
    <h2>Statuses</h2>
    <a href="/statuses/add" class="btn btn-primary">+ Add New Status</a>
</div>

<div class="entity-description">
    <h3>What are Statuses?</h3>
    <p>
        Statuses represent the current state of an incident throughout its lifecycle. Each status reflects where an incident stands in the investigation and response process. Standard statuses include Open (newly reported), Investigating (actively being worked on), and Closed (resolved or concluded).
    </p>
    <div class="description-meta">
        <span><strong>Standard Statuses:</strong> Open, Investigating, Closed</span>
        <span><strong>Purpose:</strong> Track incident workflow and prioritize investigation efforts</span>
    </div>
</div>

<div class="crud-section">
    {{#if statuses}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Status Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each statuses}}
                    <tr>
                        <td>{{this.statusID}}</td>
                        <td><span class="status-badge status-{{this.statusName}}">{{this.statusName}}</span></td>
                        <td>
                            <a href="/statuses/{{this.statusID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <button type="button" class="btn btn-danger btn-small" onclick="deleteStatus('{{this.statusID}}')">Delete</button>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No statuses found. <a href="/statuses/add">Add one now</a></p>
    {{/if}}
</div>

<script>
async function deleteStatus(statusId) {
    if (!confirm('Are you sure you want to delete this status?')) {
        return;
    }

    try {
        const response = await fetch(`/statuses/${statusId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const result = await response.json();

        if (response.ok && result.success) {
            // Successfully deleted, reload the page to update the table
            window.location.reload();
        } else {
            // Trigger popup alert with the error message from the backend
            alert(result.message || "An error occurred while deleting.");
        }
    } catch (err) {
        console.error(err);
        alert("Alert: Could not connect to the server.");
    }
}
</script>