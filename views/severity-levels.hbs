<div class="page-header">
    <h2>Severity Levels</h2>
    <a href="/severity-levels/add" class="btn btn-primary">+ Add New Severity Level</a>
</div>

<div class="entity-description">
    <h3>What are Severity Levels?</h3>
    <p>
        Severity levels categorize incidents by how critical they are to your organization. Each severity level has a defined response time (in hours) that indicates how quickly the SOC team should triage and begin investigating. Higher severity incidents demand faster response. The standard levels are Low, Medium, High, Critical, and Info.
    </p>
    <div class="description-meta">
        <span><strong>Standard Levels:</strong> Low, Medium, High, Critical, Info</span>
        <span><strong>Purpose:</strong> Define response time SLAs and incident prioritization</span>
    </div>
</div>

<div class="crud-section">
    {{#if severities}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Severity Name</th>
                    <th>Response Hours</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each severities}}
                    <tr>
                        <td>{{this.severityLevelID}}</td>
                        <td><span class="severity-badge severity-{{this.severityName}}">{{this.severityName}}</span></td>
                        <td><strong>{{this.responseHours}} hours</strong></td>
                        <td>
                            <a href="/severity-levels/{{this.severityLevelID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <button type="button" class="btn btn-danger btn-small" onclick="deleteSeverity('{{this.severityLevelID}}')">Delete</button>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No severity levels found. <a href="/severity-levels/add">Add one now</a></p>
    {{/if}}
</div>

<script>
async function deleteSeverity(severityId) {
    if (!confirm('Are you sure you want to delete this severity level?')) {
        return;
    }

    try {
        const response = await fetch(`/severity-levels/${severityId}/delete`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            }
        });

        const result = await response.json();

        if (response.ok && result.success) {
            window.location.reload();
        } else {
            alert(result.message || "An error occurred while deleting.");
        }
    } catch (err) {
        console.error(err);
        alert("Alert: Could not connect to the server.");
    }
}
</script>