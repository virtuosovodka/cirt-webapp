<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Asset - CIRT</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="logo">CIRT</h1>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/incidents">Incidents</a></li>
                <li><a href="/analysts">Analysts</a></li>
                <li><a href="/assets">Assets</a></li>
                <li><a href="/cves">CVEs</a></li>
                <li><a href="/severity-levels">Severity Levels</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h2>Add New Asset</h2>
        </div>

        <form method="POST" action="/assets" class="form">
            <div class="form-group">
                <label for="name">Asset Name *</label>
                <input type="text" id="name" name="name" required placeholder="e.g., web-prod-server-01">
            </div>

            <div class="form-group">
                <label for="ipAddress">IP Address</label>
                <input type="text" id="ipAddress" name="ipAddress" placeholder="e.g., 192.168.1.100">
            </div>

            <div class="form-group">
                <label for="department">Department</label>
                <input type="text" id="department" name="department" placeholder="e.g., Engineering">
            </div>

            <div class="form-group">
                <label for="type">Type *</label>
                <select id="type" name="type" required>
                    <option value="">-- Select Type --</option>
                    <option value="Server">Server</option>
                    <option value="Workstation">Workstation</option>
                    <option value="Router">Router</option>
                    <option value="Firewall">Firewall</option>
                    <option value="Switch">Switch</option>
                    <option value="Other">Other</option>
                </select>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add Asset</button>
                <a href="/assets" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>

    <footer>
        <p>&copy; 2026 CIRT - CS340 Group 38</p>
    </footer>
</body>
</html>