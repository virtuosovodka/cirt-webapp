<div class="page-header">
    <h2>Add New Asset</h2>
</div>

<form method="POST" action="/assets" class="form">
    <div class="form-group">
        <label for="name">Asset Name *</label>
        <input type="text" id="name" name="name" placeholder="e.g., web-prod-server-01" required>
    </div>

    <div class="form-group">
        <label for="ipAddress">IP Address</label>
        <input type="text" id="ipAddress" name="ipAddress" placeholder="e.g., 192.168.1.100">
    </div>

    <div class="form-group">
        <label for="department">Department</label>
        <input type="text" id="department" name="department" placeholder="e.g., Engineering">
    </div>

    <div class="form-group">
        <label for="type">Asset Type *</label>
        <input type="text" id="type" name="type" placeholder="e.g., Server, Workstation, Router, Firewall" required>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add Asset</button>
        <a href="/assets" class="btn btn-secondary">Cancel</a>
    </div>
</form>