<div class="page-header">
    <h2>Analysts</h2>
    <a href="/analysts/add" class="btn btn-primary">+ Add New Analyst</a>
</div>

<div class="entity-description">
    <h3>Who are Analysts?</h3>
    <p>
        Analysts are the SOC personnel who investigate and respond to security incidents. Each analyst has a role (Tier 1, Tier 2, Tier 3, or Lead) that reflects their experience level and responsibilities. Multiple analysts can collaborate on a single incident, and each analyst can be assigned to multiple incidents.
    </p>
    <div class="description-meta">
        <span><strong>Roles:</strong> Tier 1, Tier 2, Tier 3, Lead</span>
        <span><strong>Tracks:</strong> Name, email, hire date, role assignments</span>
    </div>
</div>

<div class="crud-section">
    {{#if analysts}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Hire Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each analysts}}
                    <tr>
                        <td>{{this.analystID}}</td>
                        <td>{{this.firstName}}</td>
                        <td>{{this.lastName}}</td>
                        <td>{{this.email}}</td>
                        <td>{{this.role}}</td>
                        <td>{{formatDate this.hireDate}}</td>
                        <td>
                            <a href="/analysts/{{this.analystID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <form method="POST" action="/analysts/{{this.analystID}}/delete" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-small" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No analysts found. <a href="/analysts/add">Add one now</a></p>
    {{/if}}
</div>