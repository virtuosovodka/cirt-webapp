<div class="page-header">
    <h2>Edit CVE</h2>
</div>

<form method="POST" action="/cves/{{cve.cveID}}" class="form">
    <div class="form-group">
        <label for="cveCode">CVE Code *</label>
        <input type="text" id="cveCode" name="cveCode" value="{{cve.cveCode}}" required>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4">{{cve.description}}</textarea>
    </div>

    <div class="form-group">
        <label for="cvssScore">CVSS Score</label>
        <input type="number" id="cvssScore" name="cvssScore" step="0.1" min="0" max="10" value="{{cve.cvssScore}}">
    </div>

    <div class="form-group">
        <label for="publishedDate">Published Date</label>
        <input type="date" id="publishedDate" name="publishedDate" value="{{cve.publishedDate}}">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update CVE</button>
        <a href="/cves" class="btn btn-secondary">Cancel</a>
    </div>
</form>