<div class="page-header">
    <h2>Add New Severity Level</h2>
</div>

<form method="POST" action="/severity-levels" class="form">
    <div class="form-group">
        <label for="severityName">Severity Name *</label>
        <input type="text" id="severityName" name="severityName" placeholder="e.g., Low, Medium, High, Critical, Info" required>
    </div>

    <div class="form-group">
        <label for="responseHours">Response Hours *</label>
        <input type="number" id="responseHours" name="responseHours" placeholder="e.g., 8" required>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add Severity Level</button>
        <a href="/severity-levels" class="btn btn-secondary">Cancel</a>
    </div>
</form>