<div class="page-header">
    <h2>Add New CVE</h2>
</div>

<form method="POST" action="/cves" class="form">
    <div class="form-group">
        <label for="cveCode">CVE Code *</label>
        <input type="text" id="cveCode" name="cveCode" placeholder="e.g., CVE-2026-12345" required>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="4" placeholder="Describe the vulnerability..."></textarea>
    </div>

    <div class="form-group">
        <label for="cvssScore">CVSS Score</label>
        <input type="number" id="cvssScore" name="cvssScore" step="0.1" min="0" max="10" placeholder="0.0 - 10.0">
    </div>

    <div class="form-group">
        <label for="publishedDate">Published Date</label>
        <input type="date" id="publishedDate" name="publishedDate">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Add CVE</button>
        <a href="/cves" class="btn btn-secondary">Cancel</a>
    </div>
</form>