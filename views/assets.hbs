<div class="page-header">
    <h2>Assets</h2>
    <a href="/assets/add" class="btn btn-primary">+ Add New Asset</a>
</div>

<div class="entity-description">
    <h3>What are Assets?</h3>
    <p>
        Assets are the systems, servers, workstations, and network devices that your organization monitors for security threats. Each asset has an asset type (such as Server, Workstation, Router, or Firewall) and belongs to a specific department. Incidents can affect one or multiple assets, and tracking which assets are involved helps prioritize response efforts.
    </p>
    <div class="description-meta">
        <span><strong>Types:</strong> Server, Workstation, Router, Firewall</span>
        <span><strong>Tracks:</strong> Name, IP address, department, device type</span>
    </div>
</div>

<div class="crud-section">
    {{#if assets}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>IP Address</th>
                    <th>Department</th>
                    <th>Type</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each assets}}
                    <tr>
                        <td>{{this.assetID}}</td>
                        <td>{{this.name}}</td>
                        <td>{{this.ipAddress}}</td>
                        <td>{{this.department}}</td>
                        <td>{{this.type}}</td>
                        <td>
                            <a href="/assets/{{this.assetID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <form method="POST" action="/assets/{{this.assetID}}/delete" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-small" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No assets found. <a href="/assets/add">Add one now</a></p>
    {{/if}}
</div>