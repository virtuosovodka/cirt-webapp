<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Assets - CIRT</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="nav-container">
            <h1 class="logo">CIRT</h1>
            <ul class="nav-links">
                <li><a href="/">Home</a></li>
                <li><a href="/incidents">Incidents</a></li>
                <li><a href="/analysts">Analysts</a></li>
                <li><a href="/assets">Assets</a></li>
                <li><a href="/cves">CVEs</a></li>
                <li><a href="/severity-levels">Severity Levels</a></li>
            </ul>
        </div>
    </nav>

    <div class="container">
        <div class="page-header">
            <h2>Assets</h2>
            <a href="/assets/add" class="btn btn-primary">+ Add New Asset</a>
        </div>

        {{#if assets}}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>IP Address</th>
                        <th>Department</th>
                        <th>Type</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each assets}}
                        <tr>
                            <td>{{this.assetID}}</td>
                            <td>{{this.name}}</td>
                            <td>{{this.ipAddress}}</td>
                            <td>{{this.department}}</td>
                            <td>{{this.type}}</td>
                            <td>
                                <a href="/assets/{{this.assetID}}/edit" class="btn btn-small">Edit</a>
                                <form method="POST" action="/assets/{{this.assetID}}/delete" style="display:inline;">
                                    <button type="submit" class="btn btn-small btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        {{else}}
            <p class="empty-state">No assets found. <a href="/assets/add">Add one now</a></p>
        {{/if}}
    </div>

    <footer>
        <p>&copy; 2026 CIRT - CS340 Group 38</p>
    </footer>
</body>
</html>