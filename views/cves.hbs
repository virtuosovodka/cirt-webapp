<div class="page-header">
    <h2>CVEs (Common Vulnerabilities and Exposures)</h2>
    <a href="/cves/add" class="btn btn-primary">+ Add New CVE</a>
</div>

<div class="entity-description">
    <h3>What are CVEs?</h3>
    <p>
        CVEs are publicly known security vulnerabilities in software and hardware that could affect your organization. Each CVE has a unique identifier (CVE-YEAR-NUMBER), a CVSS score indicating severity, and a description. Your SOC team tracks which CVEs are relevant to your environment and which incidents involve specific vulnerabilities.
    </p>
    <div class="description-meta">
        <span><strong>CVSS Range:</strong> 0.0 to 10.0 (higher = more severe)</span>
        <span><strong>Tracks:</strong> CVE code, description, CVSS score, published date</span>
    </div>
</div>

<div class="crud-section">
    {{#if cves}}
        <table class="data-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>CVE Code</th>
                    <th>Description</th>
                    <th>CVSS Score</th>
                    <th>Published Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {{#each cves}}
                    <tr>
                        <td>{{this.cveID}}</td>
                        <td><strong>{{this.cveCode}}</strong></td>
                        <td>{{this.description}}</td>
                        <td>{{this.cvssScore}}</td>
                        <td>{{this.publishedDate}}</td>
                        <td>
                            <a href="/cves/{{this.cveID}}/edit" class="btn btn-secondary btn-small">Edit</a>
                            <form method="POST" action="/cves/{{this.cveID}}/delete" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-small" onclick="return confirm('Are you sure?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else}}
        <p class="empty-state">No CVEs found. <a href="/cves/add">Add one now</a></p>
    {{/if}}
</div>