<div class="page-header">
    <h2>Edit Incident</h2>
</div>

<form method="POST" action="/incidents/{{incident.incidentID}}" class="form">
    <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" value="{{incident.title}}" required>
    </div>

    <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="5">{{incident.description}}</textarea>
    </div>

    <div class="form-group">
        <label for="reportedAt">Reported At *</label>
        <input type="datetime-local" id="reportedAt" name="reportedAt" value="{{formatDateTime incident.reportedAt}}" required>
    </div>

    <div class="form-group">
        <label for="severityLevelID">Severity Level *</label>
        <select id="severityLevelID" name="severityLevelID" required>
            <option value="">-- Select Severity --</option>
            {{#each severities}}
                <option value="{{this.severityLevelID}}" {{#if (eq this.severityLevelID incident.severityLevelID)}}selected{{/if}}>{{this.severityName}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="statusID">Status *</label>
        <select id="statusID" name="statusID" required>
            <option value="">-- Select Status --</option>
            {{#each statuses}}
                <option value="{{this.statusID}}" {{#if (eq this.statusID incident.statusID)}}selected{{/if}}>{{this.statusName}}</option>
            {{/each}}
        </select>
    </div>

    <div class="form-group">
        <label for="closedAt">Closed At</label>
        <input type="datetime-local" id="closedAt" name="closedAt" value="{{formatDateTime incident.closedAt}}">
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Update Incident</button>
        <a href="/incidents" class="btn btn-secondary">Cancel</a>
    </div>
</form>